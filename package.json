{
	"name": "p-state",
	"version": "2.0.1",
	"description": "Inspect the state of a promise",
	"license": "MIT",
	"repository": "sindresorhus/p-state",
	"funding": "https://github.com/sponsors/sindresorhus",
	"author": {
		"name": "Sindre Sorhus",
		"email": "sindresorhus@gmail.com",
		"url": "https://sindresorhus.com"
	},
	"type": "module",
	"exports": {
		"types": "./index.d.ts",
		"node": "./index.js",
		"default": "./browser.js"
	},
	"sideEffects": false,
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"test": "xo && node --test test.js && tsd"
	},
	"files": [
		"index.js",
		"index.d.ts",
		"browser.js"
	],
	"keywords": [
		"promise",
		"state",
		"inspect",
		"inspection",
		"reflect",
		"reflection",
		"introspect",
		"introspection",
		"pending",
		"fulfilled",
		"rejected"
	],
	"devDependencies": {
		"delay": "^6.0.0",
		"tsd": "^0.33.0",
		"xo": "^1.2.2"
	},
	"xo": {
		"rules": {
			"promise/prefer-await-to-then": "off"
		}
	}
}
